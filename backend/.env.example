# =============================================================================
# SECOND OPINION — BACKEND ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# Choose ONE provider and set its API key. The provider is selected in
# backend/app/services/llm/llm_client.py
# -----------------------------------------------------------------------------

# Option A: OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# Option B: Anthropic
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-3-haiku-20240307

# Option C: Google Gemini
# LLM_PROVIDER=gemini
# LLM_API_KEY=...
# LLM_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL)
# Use a direct PostgreSQL connection string (not the Supabase REST API URL).
# Format: postgresql://user:password@host:port/dbname
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# -----------------------------------------------------------------------------
# Supabase Storage (optional — only if retaining original uploaded files)
# -----------------------------------------------------------------------------
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=source-documents

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Frontend origin for CORS (Vite default)
FRONTEND_ORIGIN=http://localhost:5173

# Maximum upload size in megabytes
MAX_UPLOAD_SIZE_MB=15

# Backend server host/port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# OCR Configuration
# Tesseract executable path (if not in system PATH)
# Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: usually not needed if installed via package manager
# -----------------------------------------------------------------------------
# TESSERACT_CMD=